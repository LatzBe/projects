# Database
DATABASE_URL="postgresql://shopfluence:shopfluence@localhost:5432/shopfluence"

# Auth
JWT_SECRET="change-me-in-production"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# ─── Instagram Crawler ───────────────────────────────────────────────────────
# 1. Go to https://developers.facebook.com and create an app (type: Consumer)
# 2. Add the "Instagram Basic Display" product
# 3. Add your Instagram test account under App Roles → Roles → Instagram Testers
# 4. Generate a User Token via the Token Generator in the Instagram Basic Display settings
# 5. Exchange for a long-lived token (valid 60 days):
#    curl -X GET "https://graph.instagram.com/access_token \
#      ?grant_type=ig_exchange_token \
#      &client_secret=YOUR_APP_SECRET \
#      &access_token=SHORT_LIVED_TOKEN"
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
