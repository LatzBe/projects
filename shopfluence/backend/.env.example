# Database
DATABASE_URL="postgresql://shopfluence:shopfluence@localhost:5432/shopfluence"

# Auth
JWT_SECRET="change-me-in-production"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# ─── Instagram Crawler (Playwright) ──────────────────────────────────────────
# The crawler logs into Instagram with a real account and scrapes public
# profiles using a headless browser. Use a dedicated test/burner account —
# not your personal account — to avoid any risk of suspension.
#
# Setup:
#   cd backend && npx playwright install chromium
#
# Then trigger a crawl:
#   POST /api/crawler/instagram/:influencerId   (JWT auth required)
INSTAGRAM_USERNAME=your_test_account_username
INSTAGRAM_PASSWORD=your_test_account_password
